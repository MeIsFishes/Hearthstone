<Window x:Class="BbxDeployer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BbxDeployer"
        Width="1040"
        Height="720"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="86"/>
        </Style>
        <Style x:Key="ProjectCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#DDE4EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="White"
                BorderBrush="#D5DCE5"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Add Project..."
                                Command="{Binding AddTargetCommand}"
                                MinWidth="110"
                                Margin="0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Projects"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#18212F"/>
                        <TextBlock Text="The main project overwrites the selected directories in every destination project."
                                   Foreground="#64748B"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                <Border
                        Style="{StaticResource ProjectCard}"
                        Background="#EFF6FF"
                        BorderBrush="#93C5FD"
                        Padding="16"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="52"
                                Height="52"
                                CornerRadius="8"
                                Background="#2563EB"
                                Margin="0,0,14,0">
                            <TextBlock Text="M"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MAIN PROJECT"
                                           Foreground="#2563EB"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SourceStatus}"
                                           Foreground="#64748B"
                                           FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MainProjectName}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#172033"
                                       Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding MainProjectRoot}"
                                       Foreground="#475569"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="Source"
                                   Foreground="#2563EB"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="7"
                                            Background="#E2E8F0"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="D"
                                                   Foreground="#475569"
                                                   FontWeight="Bold"
                                                   FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding RootDirectory}"
                                                   Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <Button Content="Select as Source"
                                                Command="{Binding DataContext.SelectAsSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                MinWidth="120"
                                                Margin="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Margin="0,10,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnityVersionSelectionVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Unity Version"
                                                   Foreground="#475569"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding AvailableUnityEditors}"
                                                  SelectedItem="{Binding SelectedUnityEditor, Mode=TwoWay}"
                                                  DisplayMemberPath="Version"
                                                  MinWidth="170"
                                                  Padding="7,4"/>
                                        <TextBlock Text="Used when Sync Now creates this project"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Expander Grid.Row="2"
                                              Grid.ColumnSpan="3"
                                              Header="Files newer than the main project"
                                              Foreground="#DC2626"
                                              Margin="56,10,0,0">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRiskFiles}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <ItemsControl ItemsSource="{Binding RiskFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="#991B1B"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                    <Expander Grid.Row="3"
                                              Grid.Column="1"
                                              Grid.ColumnSpan="2"
                                              Header="Project Details"
                                              Foreground="#475569"
                                              Margin="0,8,0,0">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Game Project"
                                                       Foreground="#64748B"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding UnityProjectRoot}"
                                                       Foreground="#334155"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,10,0,0">
                                                <Button Content="Change..."
                                                        Command="{Binding DataContext.EditTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        MinWidth="90"/>
                                                <Button Content="Remove from List"
                                                        Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        MinWidth="130"
                                                        Margin="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SummaryText}"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               TextWrapping="Wrap"/>
                    <ProgressBar Grid.Row="1"
                                 Height="10"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"/>
                </Grid>

                <Expander Grid.Row="3" Header="Details" Margin="0,10,0,10">
                    <ListBox ItemsSource="{Binding Messages}"
                             Height="90"
                             FontFamily="Consolas"
                             FontSize="12"/>
                </Expander>

                <DockPanel Grid.Row="4">
                    <Button DockPanel.Dock="Left"
                            Content="Settings"
                            Command="{Binding OpenSettingsCommand}"
                            MinWidth="96"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Preview"
                                Command="{Binding PreviewCommand}"/>
                        <Button Content="Sync Now"
                                Command="{Binding SyncCommand}"
                                Background="#2563EB"
                                Foreground="White"
                                Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="#475569"
                               TextTrimming="CharacterEllipsis"
                               Margin="10,0"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
