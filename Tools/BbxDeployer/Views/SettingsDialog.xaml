<Window x:Class="BbxDeployer.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="820"
        Height="520"
        MinWidth="700"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Transfer Directories"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"/>
            <TextBlock Text="Every whitelist path is always included. Each group can contain multiple paths and per-path blacklists; use {GameProject} for each Unity game folder."
                       Foreground="#64748B"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D8DEE6"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <DataGrid ItemsSource="{Binding SyncItems}"
                      SelectedItem="{Binding SelectedSyncItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding DisplayName}"
                                        IsReadOnly="True"
                                        Width="180"/>
                    <DataGridTextColumn Header="Whitelist Paths"
                                        Binding="{Binding RelativeDirectory}"
                                        IsReadOnly="True"
                                        Width="*"/>
                    <DataGridTextColumn Header="Blacklists"
                                        Binding="{Binding ExclusionsDisplay}"
                                        IsReadOnly="True"
                                        Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,12,0,14">
            <Button Content="Add Directory..."
                    Command="{Binding AddSyncItemCommand}"
                    Padding="14,7"
                    Margin="0,0,12,0"/>
            <Button Content="Edit..."
                    Command="{Binding EditSyncItemCommand}"
                    Padding="14,7"
                    Margin="0,0,12,0"/>
            <Button Content="Remove"
                    Command="{Binding RemoveSyncItemCommand}"
                    Padding="14,7"/>
        </WrapPanel>

        <DockPanel Grid.Row="3">
            <TextBlock Text="Examples: Tools · {GameProject}/Assets/Scripts/BbxCommon"
                       Foreground="#64748B"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="Close"
                    Width="90"
                    Padding="14,7"
                    IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
