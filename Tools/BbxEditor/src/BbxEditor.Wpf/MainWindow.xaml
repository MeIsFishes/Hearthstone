<Window x:Class="BbxEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BbxEditor.Wpf.ViewModels"
        xmlns:views="clr-namespace:BbxEditor.Wpf.Views"
        Title="BbxEditor .NET" Icon="Assets/BbxEditor.ico"
        Width="1600" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TimelineDocumentViewModel}">
            <views:TimelineEditorControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BehaviorTreeDocumentViewModel}">
            <views:BehaviorTreeEditorControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CsvDocumentViewModel}">
            <views:CsvEditorControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScriptableObjectDocumentViewModel}">
            <views:ScriptableObjectEditorControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DesignPlanDocumentViewModel}">
            <views:DesignPlanViewerControl />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="New Timeline" Command="{Binding NewTimelineCommand}" />
                <MenuItem Header="New Behavior Tree" Command="{Binding NewBehaviorTreeCommand}" />
                <MenuItem Header="New CSV" Command="{Binding NewCsvCommand}" />
                <Separator />
                <MenuItem Header="Open…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open Recent" ItemsSource="{Binding RecentFileMenuItems}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="ToolTip" Value="{Binding FullPath}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save As…" Command="{Binding SaveAsCommand}" />
            </MenuItem>
            <MenuItem Header="Settings">
                <MenuItem Header="Edit Settings…" Click="OpenSettings_Click" />
                <Separator />
                <MenuItem Header="Reload Metadata" Command="{Binding ReloadCatalogCommand}" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <views:ExplorerControl />
            </Border>

            <GridSplitter Grid.Column="1" Width="5" />

            <TabControl x:Name="DocumentTabs" Grid.Column="2" ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding CurrentDocument}" PreviewMouseDown="DocumentTabs_PreviewMouseDown">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource StateMetadataBadgeStyle}">
                                <TextBlock Text="{Binding State}" Foreground="#171A1D" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource PriorityMetadataBadgeStyle}">
                                <TextBlock Text="{Binding Priority}" Foreground="#171A1D" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="×" Command="{Binding CloseCommand}" Style="{StaticResource IconButtonStyle}"
                                    Width="22" Height="22" FontSize="13" Margin="6,0,0,0" ToolTip="Close" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>

            <GridSplitter Grid.Column="3" Width="5" />
            <Grid Grid.Column="4">
                        <views:InspectorControl x:Name="Inspector"
                                                Task="{Binding SelectedTask}"
                                                TimelineItem="{Binding SelectedTimelineItem}"
                                                Catalog="{Binding Catalog}"
                                                BindingContextType="{Binding CurrentDocument.TaskDocument.BindingContextType}"
                                                CsvDocument="{Binding CurrentDocument.CsvDocument}"
                                                CsvRow="{Binding CurrentDocument.SelectedCsvRow}">
                            <views:InspectorControl.Style>
                                <Style TargetType="views:InspectorControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDocument.IsTask}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDocument.IsCsv}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:InspectorControl.Style>
                        </views:InspectorControl>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDocument.IsScriptableObject}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="BbxScriptableObject" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding CurrentDocument.MetadataText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Only fields described by Unity-exported metadata are editable. Unity YAML system fields remain unchanged."
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Button Style="{StaticResource FlatButtonStyle}" Padding="8,2" Margin="0"
                        MinHeight="0"
                        HorizontalContentAlignment="Left" Click="OpenLogs_Click"
                        ToolTip="Open log details">
                    <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Log.HasErrors}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Log.SummaryText}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
