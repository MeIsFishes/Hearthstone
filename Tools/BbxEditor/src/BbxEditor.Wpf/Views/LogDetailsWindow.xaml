<Window x:Class="BbxEditor.Wpf.Views.LogDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logs" Width="980" Height="620" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Log Details" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="80" />
                <DataGridTextColumn Header="Level" Binding="{Binding LevelText}" Width="90" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="280" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" MinWidth="90" HorizontalAlignment="Right"
                Margin="0,12,0,0" Click="Close_Click" />
    </Grid>
</Window>
