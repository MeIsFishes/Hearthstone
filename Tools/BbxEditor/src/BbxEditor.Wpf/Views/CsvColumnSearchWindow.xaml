<Window x:Class="BbxEditor.Wpf.Views.CsvColumnSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Turn To Row" Width="640" Height="560" MinWidth="520" MinHeight="420"
        Style="{StaticResource {x:Type Window}}"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="CanResizeWithGrip">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="8"
                                  GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DialogTitle}" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="&#x00D7;" Width="30" Height="30"
                            Style="{StaticResource IconButtonStyle}" ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,18,20,12">
                <TextBlock Text="{Binding DialogTitle}" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SearchDescription}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,12" />
                <TextBox x:Name="SearchBox" ToolTip="Search values in this column"
                         TextChanged="SearchBox_TextChanged" />
            </StackPanel>

            <Border Grid.Row="2" Margin="20,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5">
                <ListBox x:Name="ResultList" ItemsSource="{Binding FilteredRows}"
                         SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RowLabel}" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8" Padding="20,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Double-click a row to navigate" Foreground="{StaticResource TextMutedBrush}" />
                    <Button Grid.Column="1" Content="Cancel" IsCancel="True" MinWidth="82" />
                    <Button x:Name="GoToButton" Grid.Column="2" Content="Go To" IsDefault="True"
                            IsEnabled="False" MinWidth="82" Style="{StaticResource PrimaryButtonStyle}"
                            Click="GoToButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
