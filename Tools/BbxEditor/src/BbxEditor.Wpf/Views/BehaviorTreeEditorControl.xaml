<UserControl x:Class="BbxEditor.Wpf.Views.BehaviorTreeEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BbxEditor.Wpf.Views"
             PreviewKeyDown="UserControl_PreviewKeyDown" Unloaded="UserControl_Unloaded">
    <Grid Background="{StaticResource WorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
            <WrapPanel>
                <Button Content="＋ Add Task" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddNodeCommand}" />
                <Button Content="Delete Node" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteNodeCommand}" />
                <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="7,5" />
                <Button Content="Set as Connection Source" Command="{Binding SetConnectionSourceCommand}" />
                <TextBlock Text="{Binding ConnectionSourceText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0" />
                <ComboBox Width="145" Margin="3" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" />
                <Button Content="Connect to Current Node" Command="{Binding ConnectToSelectedCommand}" />
                <Button Content="Disconnect Parent" Command="{Binding DisconnectIncomingCommand}" />
                <Button Content="Order ↑" Command="{Binding MoveEdgeUpCommand}" />
                <Button Content="Order ↓" Command="{Binding MoveEdgeDownCommand}" />
                <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="7,5" />
                <Button Content="Validate" Command="{Binding ValidateCommand}" />
            </WrapPanel>
        </Border>

        <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed"
                Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Find node" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,10,0" />
                <TextBox x:Name="FindBox" Grid.Column="1" ToolTip="Search node titles and type names"
                         TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />
                <Button Grid.Column="2" Content="Next" Margin="7,3,3,3" MinWidth="70"
                        ToolTip="Find next (Enter)" Click="FindNext_Click" />
                <TextBlock x:Name="FindResultText" Grid.Column="3" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="9,0" />
                <TextBlock Grid.Column="4" Text="{Binding NodeSearchIndexStatus}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" Margin="6,0" />
                <Button Grid.Column="5" Content="×" Style="{StaticResource IconButtonStyle}"
                        ToolTip="Close search" Click="CloseFind_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="10" Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <views:BehaviorTreeCanvas x:Name="Canvas" ViewModel="{Binding}" />
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="11,7">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Ctrl+F finds nodes · Left-click to select or drag nodes · Drag from a right-side port to connect · Drop on empty space to choose and create a task · Esc cancels a connection · Mouse wheel zooms · Middle- or right-drag pans"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
