<Window x:Class="BbxEditor.Wpf.Views.ExternalFileChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Changed on Disk" Width="540" Height="250"
        MinWidth="460" MinHeight="220" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="File Changed on Disk" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="This document has local edits, and its file was modified by another program."
                       Style="{StaticResource CaptionTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FilePath}" Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Keep Local" MinWidth="100" Click="KeepLocal_Click" />
            <Button Content="Reload" MinWidth="100" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="8,3,3,3" Click="Reload_Click" />
        </StackPanel>
    </Grid>
</Window>
