<UserControl x:Class="BbxEditor.Wpf.Views.DesignPlanViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AssociatedDocumentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#355A78" />
            <Setter Property="BorderBrush" Value="#527B9D" />
            <Setter Property="Foreground" Value="#F0F1F3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#426D91" />
                    <Setter Property="BorderBrush" Value="#6D96B6" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#29465E" />
                    <Setter Property="BorderBrush" Value="#416B8C" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="AssociatedDocumentsBar"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Related documents"
                           Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button x:Name="PlanButton"
                        Content="Open Plan"
                        Style="{StaticResource AssociatedDocumentButtonStyle}"
                        Visibility="Collapsed"
                        Click="PlanButton_Click" />
                <Button x:Name="ReviewButton"
                        Content="Open Review"
                        Style="{StaticResource AssociatedDocumentButtonStyle}"
                        Visibility="Collapsed"
                        Click="ReviewButton_Click" />
            </StackPanel>
        </Border>
        <WebBrowser x:Name="Browser" Grid.Row="1" Navigating="Browser_Navigating" />
    </Grid>
</UserControl>
