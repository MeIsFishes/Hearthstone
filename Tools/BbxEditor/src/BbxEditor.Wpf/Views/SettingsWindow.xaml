<Window x:Class="BbxEditor.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BbxEditor Settings" Width="700" Height="780" MinWidth="620" MinHeight="620"
        Style="{StaticResource {x:Type Window}}"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="CanResizeWithGrip">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Margin="0,0,9,0">
                            <TextBlock Text="T" Foreground="{StaticResource AccentHoverBrush}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="BbxEditor Settings" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="30" Height="30"
                            Style="{StaticResource IconButtonStyle}" ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,20,8">
                    <StackPanel Margin="2,0,2,16">
                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Manage the Unity project, Explorer roots, exported metadata, vector search, and current Task context."
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Game Project" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Explorer indexes supported Task, CSV, and BbxScriptableObject files below this Unity project."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GameProjectPath}" ToolTip="Unity game project root" />
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseProjectCommand}" Margin="7,0,0,0" />
                            </Grid>
                            <TextBlock Text="Explorer directories" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <TextBlock Text="One project-relative directory per line. Defaults: Assets/Resources and Mods."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ExplorerDirectoriesText}" AcceptsReturn="True" Height="68"
                                     VerticalScrollBarVisibility="Auto" ToolTip="Directories must remain inside the selected game project" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="BbxEditor Metadata" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Select the directory containing Task, CSV, and BbxScriptableObject metadata exported by Unity."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MetadataPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Directory containing BbxEditor metadata exported by Unity" />
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCatalogCommand}" Margin="7,0,2,0" />
                                <Button Grid.Column="2" Content="Reload" Command="{Binding ReloadCatalogCommand}" Margin="2,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Vector Search" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="The model directory is shared by Bbx tools through the user-level BbxCommon settings file. Changes take effect only after Apply."
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <CheckBox Content="Enable vector search" IsChecked="{Binding VectorSearchEnabled}" />
                            <TextBlock Text="Model directory" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ModelDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Directory containing the multilingual MPNet model folder" />
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseModelDirectoryCommand}" Margin="7,0,0,0" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding VectorSearchStatusText}" Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Grid.Column="1" Content="Apply" Command="{Binding ApplyVectorSearchSettingsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="Current Document Context" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="The context belongs to the active document and updates when you switch tabs."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,10" />
                            <ComboBox ItemsSource="{Binding Contexts}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedContext}" ToolTip="TaskContext bound to the current document">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentDocument}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="ToolTip" Value="Create or open a document first" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" IsCancel="True" MinWidth="88" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
