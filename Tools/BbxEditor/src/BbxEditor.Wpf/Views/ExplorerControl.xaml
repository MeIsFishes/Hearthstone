<UserControl x:Class="BbxEditor.Wpf.Views.ExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BbxEditor.Wpf.ViewModels">
    <Grid Background="{StaticResource SidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Explorer" Style="{StaticResource SectionTitleStyle}" Margin="12,10,8,8" />

        <TabControl Grid.Row="1" SelectedIndex="{Binding ExplorerTabIndex, Mode=TwoWay}" Margin="4,0,4,4">
            <TabItem Header="Files">
                <Grid Background="{StaticResource SidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,10,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Menu Background="Transparent" Padding="0" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Height="30">
                            <MenuItem Header="Create" ToolTip="Create a new document"
                                      Style="{DynamicResource {x:Type MenuItem}}"
                                      Height="30" Padding="10,0" VerticalContentAlignment="Center"
                                      Background="{StaticResource SurfaceRaisedBrush}"
                                      BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                <MenuItem Header="Timeline" Command="{Binding NewTimelineCommand}"
                                          Style="{DynamicResource {x:Type MenuItem}}" />
                                <MenuItem Header="Behavior Tree" Command="{Binding NewBehaviorTreeCommand}"
                                          Style="{DynamicResource {x:Type MenuItem}}" />
                            </MenuItem>
                        </Menu>
                        <Button Grid.Column="1" Content="↻" Command="{Binding RefreshExplorerCommand}"
                                Style="{StaticResource IconButtonStyle}" Width="30" Height="30" ToolTip="Refresh file index" />
                        <Button Grid.Column="2" Content="⋯" Click="ExplorerFilter_Click"
                                Style="{StaticResource IconButtonStyle}" Width="30" Height="30" ToolTip="Filter files">
                            <Button.ContextMenu>
                                <ContextMenu />
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="8,0,8,8">
                        <TextBox x:Name="ExplorerSearchBox" Text="{Binding ExplorerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by file name" Padding="9,6,34,6" />
                        <Border IsHitTestVisible="False" BorderBrush="Transparent"
                                BorderThickness="{Binding BorderThickness, ElementName=ExplorerSearchBox}"
                                Padding="{Binding Padding, ElementName=ExplorerSearchBox}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ExplorerSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Search files…" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Button Content="×" Click="ClearExplorerSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="26" Height="26" Margin="0,0,3,0" ToolTip="Clear search">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ExplorerSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding ExplorerFiles}"
                             SelectedItem="{Binding SelectedExplorerFile}" Margin="8,0,8,8"
                             BorderThickness="1" MouseDoubleClick="ExplorerFileList_DoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="5,2">
                                                <TextBlock Text="{Binding FileTypeLabel}" FontSize="10" Foreground="{StaticResource AccentHoverBrush}" />
                                            </Border>
                                            <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ModName}" Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ExplorerStatusText}" Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Open" Command="{Binding OpenExplorerFileCommand}" MinWidth="64" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Design Plan">
                <Grid Background="{StaticResource SidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,8,8,8">
                        <TextBox x:Name="DesignPlanSearchBox" Text="{Binding DesignPlanSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="9,6,34,6" />
                        <Border IsHitTestVisible="False" BorderBrush="Transparent"
                                BorderThickness="{Binding BorderThickness, ElementName=DesignPlanSearchBox}"
                                Padding="{Binding Padding, ElementName=DesignPlanSearchBox}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DesignPlanSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Search design plans…" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Button Content="×" Click="ClearDesignPlanSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="26" Height="26" Margin="0,0,3,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DesignPlanSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TreeView x:Name="DesignPlanTree" Grid.Row="1" ItemsSource="{Binding DesignPlanDates}"
                              Margin="8,0,8,8" BorderThickness="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="DesignPlanTree_SelectedItemChanged"
                              MouseDoubleClick="DesignPlanTree_DoubleClick">
                        <TreeView.Style>
                            <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDesignPlanSearchActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Style>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:DesignPlanDateViewModel}" ItemsSource="{Binding Documents}">
                                <TextBlock Text="{Binding Date}" FontWeight="SemiBold" />
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:DesignPlanFileViewModel}">
                                <Grid Margin="2,4,4,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Style="{StaticResource StateMetadataBadgeStyle}" Margin="0">
                                            <TextBlock Text="{Binding State}" Foreground="#171A1D" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Style="{StaticResource PriorityMetadataBadgeStyle}">
                                            <TextBlock Text="{Binding Priority}" Foreground="#171A1D" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource CaptionTextStyle}"
                                                   Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="True">
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                    <ListBox Grid.Row="1" ItemsSource="{Binding DesignPlanSearchResults}"
                             SelectedItem="{Binding SelectedDesignPlanFile}"
                             Margin="8,0,8,8" BorderThickness="1"
                             MouseDoubleClick="DesignPlanSearchResults_DoubleClick">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDesignPlanSearchActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Style="{StaticResource StateMetadataBadgeStyle}" Margin="0">
                                            <TextBlock Text="{Binding State}" Foreground="#171A1D" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Style="{StaticResource PriorityMetadataBadgeStyle}">
                                            <TextBlock Text="{Binding Priority}" Foreground="#171A1D" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource CaptionTextStyle}"
                                                   Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DesignPlanStatusText}" Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Open" Command="{Binding OpenDesignPlanCommand}" MinWidth="64" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
